# Python / PyInstaller build artefacts — do not commit
build/
dist/
*.egg-info/
__pycache__/
*.pyc

# Cython-compiled binaries — platform-specific, not committed
*.so
*.c

# npm install artifacts
native/
node_modules/
package-lock.json

# sphere-node.js is the obfuscated algorithm bundle (generated by npm run build
# in the SPHERE app repo). Never committed — contains the algorithm in obfuscated
# form; publish via `npm publish` from the local machine only.
# sphere-node.jsc is compiled by postinstall from the above (local V8 bytecode).
sphere-node.js
sphere-node.jsc
.sphere-node-version
