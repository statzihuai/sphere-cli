# Python / PyInstaller build artefacts — do not commit
build/
dist/
*.egg-info/
__pycache__/
*.pyc

# Cython-compiled binaries — platform-specific, not committed
*.so
*.c

# npm install artifacts
native/
node_modules/
package-lock.json

# sphere-node.jsc is generated by postinstall on the user's machine (local V8).
# sphere-node.js is the obfuscated source bundle (generated by npm run build).
# Both are NOT committed — sphere-node.js is regenerated each build.
sphere-node.jsc
.sphere-node-version
