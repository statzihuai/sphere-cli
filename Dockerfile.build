# Build the sphere CLI for Linux x86_64.
#
# Usage (from sphere-cli/):
#   docker build -f Dockerfile.build -t sphere-cli-builder .
#   docker run --rm -v "$(pwd)/dist-linux:/out" sphere-cli-builder
#
# Output: dist-linux/sphere-cli-linux-x86_64.tar.gz
#         dist-linux/install.sh

FROM python:3.12-slim-bookworm

# System build deps
RUN apt-get update && apt-get install -y --no-install-recommends \
    gcc g++ make patchelf upx-ucl \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /build

# Copy source
COPY . .

# Python deps
RUN pip install --no-cache-dir \
    cython setuptools wheel numpy \
    pyinstaller \
    pandas scipy pyarrow polars anonymeter scikit-learn \
    joblib

# Build
RUN bash build.sh

# Package into a tarball + copy install script
RUN mkdir -p /out \
 && tar -czf /out/sphere-cli-linux-x86_64.tar.gz -C dist sphere-cli \
 && cp install.sh /out/install.sh \
 && echo "✓ Linux build complete: /out/sphere-cli-linux-x86_64.tar.gz"

CMD ["sh", "-c", "cp -r /out/* /out-host/ 2>/dev/null || true"]
